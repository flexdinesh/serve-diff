{
  "name": "serve-diff-workspace",
  "private": true,
  "license": "apache-2.0",
  "bin": {
    "serve-diff": "./apps/server/src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @serve-diff/web build && pnpm --filter @serve-diff/server build",
    "dev:web": "pnpm --filter @serve-diff/web dev",
    "dev:server": "pnpm --filter @serve-diff/server dev",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:server": "pnpm --filter @serve-diff/server test",
    "test:web": "pnpm --filter @serve-diff/web test",
    "test:browser:install": "pnpm --filter @serve-diff/web test:browser:install",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.25.0"
}
